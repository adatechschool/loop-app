generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PlaceUser {
  id           String   @id @default(uuid())
  creationDate DateTime @default(now())
  userId       String
  placeId      String
  place        Place    @relation(fields: [placeId], references: [id])
  user         User     @relation(fields: [userId], references: [id])
}

model PlaceType {
  id      String @id @default(uuid())
  placeId String
  typeId  String
  place   Place  @relation(fields: [placeId], references: [id])
  type    Type   @relation(fields: [typeId], references: [id])
}

model PlaceImage {
  id      String @id @default(uuid())
  placeId String
  imageId String
  image   Image  @relation(fields: [imageId], references: [id])
  place   Place  @relation(fields: [placeId], references: [id])
}

model ImageUser {
  id         String   @id @default(uuid())
  uploadDate DateTime @default(now())
  userId     String
  imageId    String
  image      Image    @relation(fields: [imageId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
  
}

model User {
  id             String      @id @default(uuid())
  name           String
  username       String      @unique
  email          String      @unique
  password       String
  role           String
  profilePicture String?
  favorites      Favorite[]
  images         ImageUser[]
  places         PlaceUser[]

  placesCreated  Place[]     @relation("UserToPlace")
}

model Place {
  id            String       @id @default(uuid())
  name          String
  address       String
  description   String?
  accessibility Boolean?

  author        String
  authorId      String

  geoId         String

  geo           Geo          @relation(fields: [geoId], references: [id])
  images        PlaceImage[]
  types         PlaceType[]
  users         PlaceUser[]
  favorites     Favorite[]

  authorUser    User         @relation("UserToPlace", fields: [authorId], references: [id])
}

model Geo {
  id     String  @id @default(uuid())
  lat    Float
  lng    Float
  places Place[]
}

model Type {
  id     String      @id @default(uuid())
  name   String
  places PlaceType[]
}

model Favorite {
  id        String   @id @default(uuid())
  addedDate DateTime @default(now())
  userId    String
  placeId   String
  place     Place    @relation(fields: [placeId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Image {
  id      String       @id @default(uuid())
  url     String
  caption String?
  users   ImageUser[]
  places  PlaceImage[]
}
